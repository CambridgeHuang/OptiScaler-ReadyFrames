diff --git a/OptiScaler/inputs/FG/StreamlineReadyFrames.h b/OptiScaler/inputs/FG/StreamlineReadyFrames.h
new file mode 100644
--- /dev/null
+++ b/OptiScaler/inputs/FG/StreamlineReadyFrames.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+class StreamlineReadyFrames
+{
+  public:
+    enum Input : uint8_t { Constants = 1, Depth = 2, MotionVectors = 4 };
+    struct Result
+    {
+        bool ready;
+        uint32_t count;
+    };
+
+    void Reset()
+    {
+        _inputs = {};
+        _count = 0;
+        // Keep the last presented token so Off/On cannot count the same frame twice.
+    }
+
+    void Observe(uint32_t frame, Input input, bool valid)
+    {
+        if (_last && frame == *_last)
+            return;
+        auto& entry = _inputs[frame % _inputs.size()];
+        if (!entry.frame || *entry.frame != frame)
+            entry = { frame, 0 };
+        if (valid)
+            entry.mask |= input;
+        else
+            entry.mask &= ~input;
+    }
+
+    bool CanActivate(uint32_t frame, uint32_t required) const
+    {
+        return required == 0 || (_count >= required && _last && frame == *_last + 1u);
+    }
+
+    std::optional<Result> Present(uint32_t frame)
+    {
+        if (_last && frame == *_last)
+            return std::nullopt;
+        const auto& entry = _inputs[frame % _inputs.size()];
+        const bool ready = entry.frame == frame && entry.mask == (Constants | Depth | MotionVectors);
+        if (!_last || frame != *_last + 1u || !ready)
+            _count = 0;
+        if (ready && _count < 300)
+            ++_count;
+        _last = frame;
+        return Result { ready, _count };
+    }
+
+  private:
+    struct Entry
+    {
+        std::optional<uint32_t> frame;
+        uint8_t mask = 0;
+    };
+    std::array<Entry, 8> _inputs {};
+    std::optional<uint32_t> _last;
+    uint32_t _count = 0;
+};
