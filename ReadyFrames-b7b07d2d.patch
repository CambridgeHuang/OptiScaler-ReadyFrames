+bool Sl_Inputs::SupportsReadyFrames()
+{
+    const auto& state = State::Instance();
+    return state.activeFgInput == FGInput::DLSSG && state.streamlineVersion.major >= 2 &&
+           state.swapchainApi == DX12 && state.swapchainInteropApi == SwapchainInteropApi::None &&
+           (state.activeFgOutput == FGOutput::FSRFG || state.activeFgOutput == FGOutput::XeFG);
+}
+
+void Sl_Inputs::ResetReadyFramesLocked()
+{
+    _readyFrames.Reset();
+    _readyCandidate.reset();
+    _readyPresentHint.reset();
+}
+
+void Sl_Inputs::ReportReadyMode(bool enabled, uint32_t viewport)
+{
+    std::scoped_lock lock(_readyMutex);
+    if (_readyViewport != viewport || _readyRequested != enabled)
+        ResetReadyFramesLocked();
+    _readyViewport = viewport;
+    _readyRequested = enabled;
+}
+
+bool Sl_Inputs::AllowReadyActivation(uint32_t frameId, uint32_t viewport)
+{
+    const auto required = Config::Instance()->FGDLSSGRequiredReadyFrames.value_or_default();
+    std::scoped_lock lock(_readyMutex);
+    return _readyRequested && _readyViewport == viewport && _readyFrames.CanActivate(frameId, required);
+}
+
+void Sl_Inputs::BeforeReadyPresent(IFGFeature* fg)
+{
+    const auto config = Config::Instance();
+    const auto required = config->FGDLSSGRequiredReadyFrames.value_or_default();
+    const bool enabled = config->IsFGEnabled();
+    const auto& state = State::Instance();
+    std::optional<StreamlineReadyFrames::Result> result;
+    bool keepActive = false;
+    {
+        std::scoped_lock lock(_readyMutex);
+        if (!required || !enabled || !_readyRequested || state.fgChanged || state.scChanged)
+            ResetReadyFramesLocked();
+        else
+        {
+            const auto candidate = _readyPresentHint ? _readyPresentHint : _readyCandidate;
+            _readyPresentHint.reset();
+            _readyCandidate.reset();
+            if (candidate)
+            {
+                result = _readyFrames.Present(*candidate);
+                // A repeated marker for the last token must not reset or extend the streak.
+                if (!result)
+                    return;
+                keepActive = result->ready;
+            }
+            else
+                ResetReadyFramesLocked();
+        }
+    }
+
+    if (!required)
+        return;
+
+    if (result && result->count == static_cast<uint32_t>(required) && !fg->IsActive())
+        LOG_DEBUG("Streamline FG armed after {} ready frames", required);
+
+    if (keepActive && fg->IsActive() && !fg->IsPaused())
+    {
+        // Tags prove the game supplied inputs, not that the backend accepted them.
+        const auto index = fg->GetIndexWillBeDispatched();
+        keepActive = fg->IsResourceReady(FG_ResourceType::Depth, index) &&
+                     fg->IsResourceReady(FG_ResourceType::Velocity, index);
+    }
+
+    if (!keepActive && fg->IsActive())
+    {
+        LOG_DEBUG("Streamline FG stopped before Present: off or frame data incomplete");
+        fg->Disable();
+    }
+}
